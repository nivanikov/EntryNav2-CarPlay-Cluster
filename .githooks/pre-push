# Refuses a push if a commit being pushed holds the car's password, a compiled program,
# an oversized file or a local-only folder. git lists the pushed refs on stdin;
# tools/verify_repo.py reads them from there.
# Enable once with:  git config core.hooksPath .githooks
for python in python3 python py; do
    if "$python" --version >/dev/null 2>&1; then
        exec "$python" tools/verify_repo.py --pre-push
    fi
done
echo "Python not found: push refused." >&2
exit 1
